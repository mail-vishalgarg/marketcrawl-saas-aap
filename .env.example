# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real secrets.

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Used to enrich and summarise scraped Amazon product data.
OPENAI_API_KEY=sk-...your-openai-key-here...

# ── Oxylabs ──────────────────────────────────────────────────────────────────
# Realtime Scraper API credentials — https://oxylabs.io/products/scraper-api
OXYLABS_USERNAME=your_oxylabs_username
OXYLABS_PASSWORD=your_oxylabs_password

# ── Supabase ─────────────────────────────────────────────────────────────────
# Found in Supabase dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...service-role-key...

# ── Database ─────────────────────────────────────────────────────────────────
# Direct Postgres URI — used by migrations and admin tasks, not the runtime app.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# These are exposed to the browser — use the ANON key only, never service role.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...anon-key...
VITE_API_URL=http://localhost:8000
